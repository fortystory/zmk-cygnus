#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

&lt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_setting {
            bindings = <&tog 3>;
            key-positions = <24 25 34 35>;
        };

        combo_ctrl_space {
            bindings = <&kp LC(F9)>;
            key-positions = <37 40>;
            layers = <0>;
        };

        combo_f8 {
            bindings = <&kp F8>;
            key-positions = <38 39>;
            layers = <0>;
        };

        combo_colon {
            bindings = <&kp COLON>;
            key-positions = <16 22>;
            layers = <0>;
        };

        combo_left_bracket_quotation {
            bindings = <&macro_bracket_and_quotation>;
            key-positions = <16 14>;
            layers = <0>;
        };

        combo_quotation_right_bracket {
            bindings = <&macro_quotation_and_bracket>;
            key-positions = <19 21>;
            layers = <0>;
        };

        combo_arraw {
            bindings = <&macro_arraw>;
            key-positions = <15 16>;
            layers = <2>;
        };

        combo_arraw_eq {
            bindings = <&macro_arraw_eq>;
            key-positions = <3 4>;
            layers = <2>;
        };

        combo_ctrl_f19 {
            bindings = <&kp LC(F19)>;
            key-positions = <26 27 28>;
            layers = <0>;
        };

        combo_ctrl_f20 {
            bindings = <&kp LC(F20)>;
            key-positions = <2 3 4>;
            layers = <0>;
        };

        combo_s_e {
            bindings = <&macro_se>;
            key-positions = <14 3>;
            layers = <0>;
        };

        combo_l_i {
            bindings = <&macro_li>;
            key-positions = <21 8>;
            layers = <0>;
        };

        combo_fj {
            bindings = <&kp LS(SPACE)>;
            key-positions = <16 19>;
            layers = <0>;
        };

        combo_ctrl_f9 {
            bindings = <&kp LC(F9)>;
            key-positions = <36 41>;
        };

        combo_d_space {
            bindings = <&macro_d_space>;
            key-positions = <15 37>;
            layers = <0>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 14 15>;
            layers = <0>;
        };

        combo_eq {
            bindings = <&kp EQUAL>;
            key-positions = <40 16>;
            layers = <0>;
        };

        combo_dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <40 4>;
            layers = <0>;
        };

        combo_to_origin {
            bindings = <&tog 6>;
            key-positions = <36 37 40 41>;
            layers = <0>;
        };

        combo_to_qwerty {
            bindings = <&tog 0>;
            key-positions = <36 37 40 41>;
            layers = <6>;
        };

        combo_ctrl_enter {
            bindings = <&kp LC(ENTER)>;
            key-positions = <16 15 14>;
            layers = <4>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <250>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <180>;
        };

        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };

        mth: mth {
            compatible = "zmk,behavior-hold-tap";
            label = "MTH";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&lt 0 ENTER>, <&to 0>;
        };
    };

    macros {
        macro_bracket_and_quotation: macro_bracket_and_quotation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp SQT>;
            label = "MACRO_BRACKET_AND_QUOTATION";
        };

        macro_quotation_and_bracket: macro_quotation_and_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp RIGHT_BRACKET>;
            label = "MACRO_QUOTATION_AND_BRACKET";
        };

        macro_arraw: macro_arraw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_ARRAW";
        };

        macro_arraw_eq: macro_arraw_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "MACRO_ARRAW_EQ";
        };

        macro_se: macro_se {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E>;
            label = "MACRO_SE";
        };

        macro_li: macro_li {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I>;
            label = "MACRO_LI";
        };

        macro_d_space: macro_d_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp SPACE>;
            label = "MACRO_D_SPACE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp GRAVE  &kp Q           &kp W           &kp E             &kp R             &kp T         &kp Y                &kp U              &kp I        &kp O            &kp P                    &kp BSPC
&kp ESC    &hm LEFT_WIN A  &hm LEFT_ALT S  &hm LCTRL D       &hm LEFT_SHIFT F  &kp G         &kp H                &hm RIGHT_SHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm RIGHT_WIN SEMICOLON  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C             &kp V             &kp B         &kp N                &kp M              &kp COMMA    &kp DOT          &kp FSLH                 &kp DEL
                                           &lt 4 UNDERSCORE  &lt 1 SPACE       &mt LWIN TAB  &mt RIGHT_WIN ENTER  &lt 2 SPACE        &lt 5 MINUS
            >;

            label = "CYGNUS";
        };

        guid {
            bindings = <
&none    &none     &none     &none      &none      &none  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE   &none           &kp BSPC
&kp ESC  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp LEFT        &kp DOWN              &kp UP                 &kp RIGHT         &mt HOME PG_UP  &kp DOUBLE_QUOTES
&none    &none     &none     &none      &none      &none  &kp LESS_THAN   &kp LBKT              &kp RBKT               &kp GREATER_THAN  &mt END PG_DN   &kp DEL
                             &none      &kp SPACE  &none  &kp ENTER       &kp SPACE             &mt C_PREV C_NEXT
            >;

            label = "HJKL";
        };

        symbols {
            bindings = <
&kp GRAVE  &kp AMPERSAND    &kp AT_SIGN   &kp POUND  &kp DOLLAR  &kp PERCENT     &none           &none          &none      &none      &none      &kp BSPC
&kp ESC    &kp EXCLAMATION  &kp ASTERISK  &kp MINUS  &kp EQUAL   &kp TILDE       &none           &kp RSHFT      &kp RCTRL  &kp RALT   &kp RGUI   &kp ENTER
&kp LSHFT  &kp CARET        &kp SLASH     &kp PIPE   &kp BSLH    &kp UNDERSCORE  &kp UNDERSCORE  &kp BACKSLASH  &kp PIPE   &kp MINUS  &kp SLASH  &kp DEL
                                          &none      &none       &none           &none           &td1           &none
            >;

            label = "!@#$";
        };

        setting {
            bindings = <
&none  &none  &none  &none  &none  &none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR
&none  &none  &none  &none  &none  &none        &none         &none         &none         &none         &none           &none
&none  &none  &none  &none  &none  &bootloader  &bootloader   &none         &none         &none         &bt BT_CLR_ALL  &none
                     &none  &none  &none        &none         &none         &none
            >;

            label = "setting";
        };

        number {
            bindings = <
&none    &kp LC(Q)           &kp LC(W)           &kp LC(E)        &kp LC(R)             &kp LC(T)  &kp ASTRK    &kp N7  &kp N8   &kp N9  &kp EQUAL    &kp BSPC
&kp ESC  &hm LEFT_WIN LC(A)  &hm LEFT_ALT LC(S)  &hm LCTRL LC(D)  &hm LEFT_SHIFT LC(F)  &kp LC(G)  &kp MINUS    &kp N4  &kp N5   &kp N6  &kp PERCENT  &kp ENTER
&none    &kp LC(Z)           &kp LC(X)           &kp LC(C)        &kp LC(V)             &kp LC(B)  &kp KP_PLUS  &kp N1  &kp N2   &kp N3  &kp FSLH     &none
                                                 &none            &none                 &kp TAB    &kp N0       &none   &kp DOT
            >;

            label = "12345";
        };

        fn {
            bindings = <
&none      &kp F12  &kp F11  &kp F10    &kp F9  &none  &none  &none      &none      &none     &none     &none
&none      &kp F4   &kp F3   &kp F2     &kp F1  &none  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp LSHFT  &kp F8   &kp F7   &kp F6     &kp F5  &none  &none  &none      &none      &none     &none     &none
                             &kp LCTRL  &none   &none  &none  &none      &none
            >;

            label = "F123";
        };

        origin {
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E           &kp R      &kp T    &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D           &kp F      &kp G    &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z  &kp X  &kp C           &kp V      &kp B    &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp DEL
                         &kp UNDERSCORE  &kp SPACE  &kp TAB  &kp ENTER  &kp SPACE  &kp MINUS
            >;

            label = "origin";
        };
    };
};
